{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/refs/heads/main/schemas/config.json",
  "separate-pull-requests": true,
  "prerelease": true,
  "prerelease-type": "alpha",
  "include-component-in-tag": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features", "hidden": false },
    { "type": "fix", "section": "Bug Fixes", "hidden": false },
    { "type": "deps", "section": "Dependencies", "hidden": false },
    {
      "type": "docs",
      "section": "Documentation Improvements",
      "hidden": false
    },
    { "type": "style", "section": "Design Improvements", "hidden": false },
    {
      "type": "ci",
      "section": "Continuous Integration Changes",
      "hidden": true
    },
    { "type": "chore", "section": "Maintenance", "hidden": true }
  ],
  "packages": {
    "src/developer": {
      "package-name": "developer",
      "component": "developer",
      "release-type": "node",
      "pull-request-header": ":robot: A new pre-release is ready :rocket:",
      "pull-request-title-pattern": "chore:${component} pre-release v${version}"
    },
    "src/explorer": {
      "package-name": "explorer",
      "component": "explorer",
      "release-type": "node",
      "pull-request-header": ":robot: A new pre-release is ready :rocket:",
      "pull-request-title-pattern": "chore:${component} pre-release v${version}"
    },
    "src/api": {
      "package-name": "api",
      "component": "api",
      "release-type": "simple",
      "pull-request-header": ":robot: A new pre-release is ready :rocket:",
      "pull-request-title-pattern": "chore:${component} pre-release v${version}"
    }
  }
}
