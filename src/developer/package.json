{
  "name": "@ugrc/developer",
  "version": "2.9.0",
  "private": true,
  "description": "The API key self service website for the UGRC API.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:storybook": "storybook build --output-dir ./dist/storybook",
    "dev": "cross-env NODE_ENV=development concurrently \"pnpm dev:firebase\" \"wait-on http://127.0.0.1:4000 && pnpm dev:vite\"",
    "dev:firebase": "bash ./scripts/start-emulators.sh",
    "dev:vite": "vite",
    "firebase:migrate:dev": "fireway migrate --projectId ut-dts-agrc-web-api-dev",
    "firebase:migrate:local": "FIRESTORE_EMULATOR_HOST='127.0.0.1:8080' fireway migrate --projectId ut-dts-agrc-web-api-dev",
    "firebase:migrate:prod": "fireway migrate --projectId ut-dts-agrc-web-api-prod",
    "firebase:save-state": "firebase emulators:start --import ../../data/firebase --export-on-exit --only auth,firestore,functions",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint ./ --ext .js,.jsx --quiet --fix --ignore-path ./.eslintignore",
    "preview": "vite preview",
    "start": "pnpm dev",
    "storybook": "storybook dev -p 6006",
    "test": "vitest --silent --coverage --ui --open"
  },
  "browserslist": {
    "production": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@rozsazoltan/tailwindcss-patterns": "^1.0.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "@ugrc/utah-design-system": "^4.3.2",
    "@utahdts/utah-design-system-header": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "md5": "^2.3.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-copy-to-clipboard-ts": "^1.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.4",
    "@storybook/addon-links": "10.6.4",
    "@storybook/addon-themes": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@ugrc/eslint-config": "^1.3.1",
    "@ugrc/tailwind-preset": "^2.0.1",
    "@ugrc/tsconfigs": "^1.0.4",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "firebase-tools": "^15.34.1",
    "fireway": "^1.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prop-types": "^15.8.1",
    "storybook": "10.6.4",
    "tailwindcss": "^4.3.3",
    "tailwindcss-react-aria-components": "^2.2.0",
    "vite": "^8.3.7",
    "vite-plugin-package-version": "^1.1.0",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
