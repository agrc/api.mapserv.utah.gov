{
  "name": "@ugrc/developer",
  "version": "2.8.2",
  "private": true,
  "description": "The API key self service website for the UGRC API.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:storybook": "storybook build --output-dir ./dist/storybook",
    "dev": "cross-env NODE_ENV=development concurrently \"pnpm dev:firebase\" \"wait-on http://127.0.0.1:4000 && pnpm dev:vite\"",
    "dev:firebase": "bash ./scripts/start-emulators.sh",
    "dev:vite": "vite",
    "firebase:migrate:dev": "fireway migrate --projectId ut-dts-agrc-web-api-dev",
    "firebase:migrate:local": "FIRESTORE_EMULATOR_HOST='127.0.0.1:8080' fireway migrate --projectId ut-dts-agrc-web-api-dev",
    "firebase:migrate:prod": "fireway migrate --projectId ut-dts-agrc-web-api-prod",
    "firebase:save-state": "firebase emulators:start --import ../../data/firebase --export-on-exit --only auth,firestore,functions",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint ./ --ext .js,.jsx --quiet --fix --ignore-path ./.eslintignore",
    "preview": "vite preview",
    "start": "pnpm dev",
    "storybook": "storybook dev -p 6006",
    "test": "vitest --silent --coverage --ui --open"
  },
  "browserslist": {
    "production": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "@ugrc/utah-design-system": "^4.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2",
    "md5": "^2.3.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-copy-to-clipboard-ts": "^1.3.1",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-hook-form": "^7.86.0",
    "react-router": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-links": "10.5.10",
    "@storybook/addon-themes": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@ugrc/eslint-config": "^1.3.1",
    "@ugrc/tailwind-preset": "^2.0.1",
    "@ugrc/tsconfigs": "^1.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "firebase-tools": "^15.28.2",
    "fireway": "^1.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prop-types": "^15.8.1",
    "storybook": "10.5.10",
    "tailwindcss": "^4.3.3",
    "tailwindcss-react-aria-components": "^2.2.0",
    "vite": "^8.2.2",
    "vite-plugin-package-version": "^1.1.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
