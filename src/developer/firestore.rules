rules_version = '2';
service cloud.firestore {
  function isAuthenticated() {
    return request.auth != null;
  }
  function isCurrentUser(uid) {
    return request.auth.uid == uid;
  }

  match /databases/{database}/documents {
    match /clients/{uid} {
     allow read: if isAuthenticated() && isCurrentUser(uid);
    }
    match /keys/{key} {
      allow read: if isAuthenticated() && (get(/databases/$(database)/documents/keys/$(key)).data.accountId == request.auth.uid);
      // owners may only edit their notes and pause, resume or delete the key; every other field is set by the createKey function
      allow update: if isAuthenticated()
        && (get(/databases/$(database)/documents/keys/$(key)).data.accountId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'flags'])
        && request.resource.data.flags.diff(resource.data.flags).affectedKeys().hasOnly(['disabled', 'deleted'])
        && request.resource.data.flags.get('disabled', false) is bool
        && request.resource.data.flags.get('deleted', false) is bool
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['notes'])
          || (request.resource.data.notes is string && request.resource.data.notes.size() <= 500));
    }
  }
}
